{
  "name": "@insar-agent/pi-insar",
  "version": "0.1.0",
  "private": true,
  "description": "pi extension exposing the InSAR agent FastAPI backend as insar_* tools, a monitored-pipeline sidebar and a graduated-freedom gate",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "main": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "skills": "node scripts/sync-skills.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
