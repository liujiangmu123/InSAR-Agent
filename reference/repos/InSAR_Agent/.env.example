# 必填 — DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-key-here
# 可选 — 自定义 API 地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选 — 模型选择
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选 — ASF/HyP3 账号（用于提交 InSAR 作业）
# HYP3_USERNAME=your_username
# HYP3_PASSWORD=your_password

# 可选 — ERA5 大气校正 CDS API Key (https://cds.climate.copernicus.eu/)
# CDSAPI_KEY=your-cds-key
