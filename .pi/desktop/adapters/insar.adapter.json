{
  "$schema": "pi-desktop-adapter/v1",
  "id": "insar",
  "displayName": "InSAR Agent",
  "description": "InSAR 全流程：规划/执行/监控、出图识图、报告与复现包。扩展真身在项目 .pi/extensions + pi-insar/。",
  "match": {
    "names": [
      "insar",
      "insar.ts",
      "pi-insar",
      "@insar-agent/pi-insar"
    ],
    "tools": [
      "insar_health",
      "insar_create_session",
      "insar_list_sessions",
      "insar_plan_run",
      "insar_run_status",
      "insar_execute_run",
      "insar_resume",
      "insar_view_figure",
      "insar_run_trace",
      "insar_preview_change",
      "insar_apply_change",
      "insar_intervene",
      "insar_fork_run",
      "insar_export_provenance",
      "insar_list_datasets",
      "insar_env_probe",
      "insar_read_log",
      "insar_set_mode",
      "insar_get_mode",
      "insar_capabilities",
      "insar_timeseries_point",
      "insar_list_artifacts",
      "insar_doctor",
      "insar_recommend_route",
      "insar_read_skill",
      "insar_export_product",
      "insar_vision_qa",
      "insar_report",
      "insar_figure_caption",
      "insar_repro_bundle",
      "insar_advise_next"
    ],
    "commands": [
      "/insar-mode"
    ]
  },
  "tier": "partial",
  "alwaysVisible": true,
  "toolCard": {
    "template": "list",
    "icon": "Activity",
    "statusField": "$.output.text"
  },
  "config": {
    "localKeys": [
      "apiBaseHint",
      "showInlineFigures"
    ],
    "sections": [
      {
        "title": "后端",
        "fields": [
          {
            "key": "apiBaseHint",
            "type": "text",
            "label": "INSAR_API_BASE 提示",
            "default": "http://127.0.0.1:8873",
            "description": "扩展读进程环境变量 INSAR_API_BASE；此处仅备忘。改端口请在启动脚本或系统环境里设，再重启 Desktop。"
          },
          {
            "key": "showInlineFigures",
            "type": "boolean",
            "label": "时间线尽量内联图件",
            "default": true,
            "description": "桌面本地开关；图件由 insar_view_figure 以 image content 返回。"
          }
        ],
        "i18n": {
          "zh": { "title": "后端" },
          "en": { "title": "Backend" }
        }
      }
    ],
    "actions": [
      {
        "id": "health",
        "type": "httpCheck",
        "label": "探测后端 /api/health",
        "method": "GET",
        "url": "${apiBaseHint}/api/health",
        "timeoutMs": 5000,
        "report": {
          "countPath": "ok",
          "label": "ok"
        }
      }
    ],
    "note": "InSAR 扩展随项目 .pi/ 自动加载。自由模式 /insar-mode free|strict。流水线真源是后端 /api/monitor，与 CLI 共用同一账本。",
    "i18n": {
      "zh": {
        "note": "InSAR 扩展随项目 .pi/ 自动加载。自由模式 /insar-mode free|strict。流水线真源是后端 /api/monitor，与 CLI 共用同一账本。"
      },
      "en": {
        "note": "InSAR loads via project .pi/. Use /insar-mode free|strict. Pipeline truth is GET /api/monitor, shared with CLI."
      }
    }
  },
  "slash": {
    "/insar-mode": "notify"
  },
  "i18n": {
    "zh": {
      "displayName": "InSAR Agent",
      "description": "InSAR 全流程：规划/执行/监控、出图识图、报告与复现包",
      "actionLabels": { "health": "探测后端" }
    },
    "en": {
      "displayName": "InSAR Agent",
      "description": "Full InSAR pipeline: plan/run/monitor, figures, report, repro bundle",
      "actionLabels": { "health": "Health check" }
    }
  }
}
